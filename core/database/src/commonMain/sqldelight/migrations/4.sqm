-- Schema 4 → 5 (RECURRING-PLAN.md Phase 5, ADR-008):
--  * recurring + recurring_revision: khoản định kỳ và timeline, đi qua sync.
--  * recurring_occurrence_local: chỉ trên máy, kỳ do máy này sinh (R16).
-- Phải khớp đúng Recurring.sq: DB tạo mới đi theo .sq, DB cũ đi qua đây (test: UserDatabaseMigrationTest).

CREATE TABLE recurring (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    currency TEXT NOT NULL,
    generation_not_before TEXT NOT NULL,
    generation_end_date TEXT,
    remind_days_before INTEGER,
    revision INTEGER NOT NULL,
    blocked_from TEXT,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE recurring_revision (
    id TEXT NOT NULL PRIMARY KEY,
    recurring_id TEXT NOT NULL,
    effective_from TEXT NOT NULL,
    anchor_date TEXT NOT NULL,
    account_id TEXT NOT NULL,
    category_id TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    note TEXT,
    frequency TEXT NOT NULL,
    interval_count INTEGER NOT NULL,
    weekday INTEGER,
    month INTEGER,
    day_of_month INTEGER,
    auto_confirm INTEGER NOT NULL
);

CREATE INDEX recurring_revision_owner_idx ON recurring_revision(recurring_id, effective_from);

CREATE TABLE recurring_occurrence_local (
    transaction_id TEXT NOT NULL PRIMARY KEY,
    recurring_id TEXT NOT NULL,
    scheduled_date TEXT NOT NULL,
    revision_id TEXT NOT NULL
);

CREATE INDEX recurring_occurrence_local_owner_idx ON recurring_occurrence_local(recurring_id);
