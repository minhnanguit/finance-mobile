-- Schema 2 → 3 (docs/BUDGET-PLAN.md Phase 4, ADR-007):
--  * budget: ngân sách theo danh mục chi, đi qua sync như ledger.
-- Phải khớp đúng Budget.sq: DB tạo mới đi theo .sq, DB cũ đi qua đây (test: UserDatabaseMigrationTest).

CREATE TABLE budget (
    id TEXT NOT NULL PRIMARY KEY,
    category_id TEXT NOT NULL,
    currency TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    start_month TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);
