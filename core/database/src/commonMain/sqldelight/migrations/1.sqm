-- Schema 1 → 2 (review Phase 4, docs/LEDGER-PLAN.md):
--  * outbox.next_attempt_at: backoff thay cho "dừng hẳn sau 5 lần RETRY". Op từng bị dừng được gửi lại.
--  * outbox_ref: op đổi ví/danh mục phải đợi op trước còn trỏ tới nó.
--  * sync_deferred: thay đổi từ server chưa áp được, giữ lại để áp sau khi nâng cấp app.
-- Phải khớp đúng các file .sq: DB tạo mới đi theo .sq, DB cũ đi qua đây (test: UserDatabaseMigrationTest).

ALTER TABLE outbox ADD COLUMN next_attempt_at INTEGER NOT NULL DEFAULT 0;

CREATE TABLE outbox_ref (
    seq INTEGER NOT NULL,
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    PRIMARY KEY (seq, entity, entity_id)
);

CREATE INDEX outbox_ref_target_idx ON outbox_ref(entity, entity_id, seq);

CREATE TRIGGER outbox_ref_cleanup
AFTER DELETE ON outbox
BEGIN
    DELETE FROM outbox_ref WHERE seq = old.seq;
END;

CREATE TABLE sync_deferred (
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    change_seq INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    data TEXT,
    reason TEXT NOT NULL,
    deferred_at INTEGER NOT NULL,
    PRIMARY KEY (entity, entity_id)
);
