-- Giao dịch (ADR-005). `transaction` là từ khoá SQL nên bảng tên `ledger_transaction`.
-- occurred_on: ngày ISO theo lịch user; occurred_at: epoch millis hoặc NULL khi không rõ giờ (D5).
-- Chỉ core/ledger được dùng.
CREATE TABLE ledger_transaction (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    status TEXT NOT NULL,
    account_id TEXT NOT NULL,
    counter_account_id TEXT,
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL,
    category_id TEXT,
    occurred_on TEXT NOT NULL,
    occurred_at INTEGER,
    payee TEXT,
    note TEXT,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX ledger_transaction_occurred_idx ON ledger_transaction(occurred_on DESC, id);
CREATE INDEX ledger_transaction_account_idx ON ledger_transaction(account_id);
CREATE INDEX ledger_transaction_counter_idx ON ledger_transaction(counter_account_id);
CREATE INDEX ledger_transaction_category_idx ON ledger_transaction(category_id);

upsert:
INSERT OR REPLACE INTO ledger_transaction(
    id, type, status, account_id, counter_account_id, amount_minor, currency,
    category_id, occurred_on, occurred_at, payee, note, deleted
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT * FROM ledger_transaction WHERE id = ?;

selectRecent:
SELECT * FROM ledger_transaction
WHERE deleted = 0
ORDER BY occurred_on DESC, occurred_at DESC, id DESC
LIMIT ?;

-- Tổng thu và tổng chi theo tiền tệ trong [fromDate, toDate] (ISO yyyy-MM-dd nên so sánh được theo chữ):
-- chỉ CONFIRMED chưa xoá, bỏ TRANSFER (ADR-005 D2). Phục vụ số liệu "tháng này" trên trang chủ.
-- Cộng tách thương/dư cho 10⁹ giống selectBalances (Account.sq): SUM thẳng ném "integer overflow" khi tổng
-- vượt Long và làm chết Flow; cách này chính xác trong biên Long, vượt thì CAST kẹp ở biên.
selectCashFlowBetween:
SELECT type, currency,
    CAST(
        COALESCE(SUM(amount_minor / 1000000000), 0) * 1000000000 + COALESCE(SUM(amount_minor % 1000000000), 0)
    AS INTEGER) AS total_minor
FROM ledger_transaction
WHERE deleted = 0 AND status = 'CONFIRMED' AND type IN ('INCOME', 'EXPENSE')
  AND occurred_on >= :fromDate AND occurred_on <= :toDate
GROUP BY type, currency
ORDER BY currency ASC, type ASC;

markDeleted:
UPDATE ledger_transaction SET deleted = 1 WHERE id = ?;

remove:
DELETE FROM ledger_transaction WHERE id = ?;
