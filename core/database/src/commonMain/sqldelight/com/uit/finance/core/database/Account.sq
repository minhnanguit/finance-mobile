-- Ví (ADR-005). Không đặt FK: pull có thể đưa giao dịch về trước ví của nó (ADR-002 §4).
-- Chỉ core/ledger được dùng các query này (Konsist).
CREATE TABLE account (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    currency TEXT NOT NULL,
    opening_balance_minor INTEGER NOT NULL,
    sort_order INTEGER NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER NOT NULL DEFAULT 0
);

upsert:
INSERT OR REPLACE INTO account(id, name, type, currency, opening_balance_minor, sort_order, archived, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT * FROM account WHERE id = ?;

selectActive:
SELECT * FROM account WHERE deleted = 0 ORDER BY sort_order ASC, name ASC, id ASC;

countActive:
SELECT COUNT(*) FROM account WHERE deleted = 0;

isReferenced:
SELECT COUNT(*) FROM ledger_transaction
WHERE deleted = 0 AND (account_id = :id OR counter_account_id = :id);

markDeleted:
UPDATE account SET deleted = 1 WHERE id = ?;

remove:
DELETE FROM account WHERE id = ?;

-- Số dư = ban đầu + thu − chi − chuyển đi + chuyển đến; chỉ giao dịch CONFIRMED chưa xoá (ADR-005 §5).
-- Cùng công thức với backend (AccountFlowsQueryAdapter).
--
-- Không dùng thẳng SUM(amount): SUM của SQLite ném "integer overflow" khi tổng vượt Long, làm chết cả Flow
-- số dư (tới được bằng ~9.300 giao dịch 10¹⁵). Cộng riêng phần thương và phần dư cho 10⁹ thì không bao
-- giờ tràn. Ghép lại bằng phép nhân/cộng thường: tràn thì SQLite đổi sang số thực, CAST kẹp ở biên Long.
-- Trong biên Long, kết quả vẫn chính xác tới từng đơn vị.
selectBalances:
WITH flow(account_id, amount) AS (
    SELECT account_id, CASE type WHEN 'INCOME' THEN amount_minor ELSE -amount_minor END
    FROM ledger_transaction
    WHERE deleted = 0 AND status = 'CONFIRMED'
    UNION ALL
    SELECT counter_account_id, amount_minor
    FROM ledger_transaction
    WHERE deleted = 0 AND status = 'CONFIRMED' AND type = 'TRANSFER'
),
total(account_id, high, low) AS (
    SELECT account_id, SUM(amount / 1000000000), SUM(amount % 1000000000)
    FROM flow
    GROUP BY account_id
)
SELECT
    a.id,
    a.currency,
    a.archived,
    CAST(a.opening_balance_minor + COALESCE(t.high, 0) * 1000000000 + COALESCE(t.low, 0) AS INTEGER) AS balance_minor
FROM account a
LEFT JOIN total t ON t.account_id = a.id
WHERE a.deleted = 0
ORDER BY a.sort_order ASC, a.name ASC, a.id ASC;
