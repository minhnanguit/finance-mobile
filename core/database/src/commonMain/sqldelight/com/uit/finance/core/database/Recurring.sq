-- Khoản định kỳ (ADR-009). Không đặt FK sang bảng ledger (xem Account.sq): pull có thể đưa khoản về trước ví/danh
-- mục của nó. Ngày ISO yyyy-MM-dd. Chỉ core/recurring được dùng.
--
-- revision: revision của trạng thái local. Ghi local thì gửi revision hiện tại làm điều kiện rồi tăng 1 (RS9); nhận
-- bản server (khi không còn op chờ) thì đặt bằng revision của server.
-- blocked_from: chỉ trên máy. Ngày đầu tiên không sinh được kỳ vì ví/danh mục bị chặn (R13); khác null thì generator
-- dừng khoản này tới khi user chọn bù hay bỏ qua.
CREATE TABLE recurring (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    currency TEXT NOT NULL,
    generation_not_before TEXT NOT NULL,
    generation_end_date TEXT,
    remind_days_before INTEGER,
    revision INTEGER NOT NULL,
    blocked_from TEXT,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- Timeline của một khoản (R2). Ghi lại toàn bộ mỗi lần lưu khoản.
CREATE TABLE recurring_revision (
    id TEXT NOT NULL PRIMARY KEY,
    recurring_id TEXT NOT NULL,
    effective_from TEXT NOT NULL,
    anchor_date TEXT NOT NULL,
    account_id TEXT NOT NULL,
    category_id TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    note TEXT,
    frequency TEXT NOT NULL,
    interval_count INTEGER NOT NULL,
    weekday INTEGER,
    month INTEGER,
    day_of_month INTEGER,
    auto_confirm INTEGER NOT NULL
);

CREATE INDEX recurring_revision_owner_idx ON recurring_revision(recurring_id, effective_from);

-- Chỉ trên máy, không sync: kỳ nào do chính máy này sinh, theo phiên bản nào (R16, đối soát lịch cũ).
CREATE TABLE recurring_occurrence_local (
    transaction_id TEXT NOT NULL PRIMARY KEY,
    recurring_id TEXT NOT NULL,
    scheduled_date TEXT NOT NULL,
    revision_id TEXT NOT NULL
);

CREATE INDEX recurring_occurrence_local_owner_idx ON recurring_occurrence_local(recurring_id);

upsert:
INSERT OR REPLACE INTO recurring(
    id, name, type, currency, generation_not_before, generation_end_date, remind_days_before, revision,
    blocked_from, deleted
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT * FROM recurring WHERE id = ?;

selectAll:
SELECT * FROM recurring WHERE deleted = 0 ORDER BY name COLLATE NOCASE ASC, id ASC;

countActive:
SELECT COUNT(*) FROM recurring WHERE deleted = 0 AND (generation_end_date IS NULL OR generation_end_date >= ?);

revisionOf:
SELECT revision FROM recurring WHERE id = ?;

setBlockedFrom:
UPDATE recurring SET blocked_from = ? WHERE id = ?;

markDeleted:
UPDATE recurring SET deleted = 1 WHERE id = ?;

remove:
DELETE FROM recurring WHERE id = ?;

selectRevisions:
SELECT * FROM recurring_revision WHERE recurring_id = ? ORDER BY effective_from ASC;

selectAllRevisions:
SELECT r.* FROM recurring_revision r
JOIN recurring k ON k.id = r.recurring_id
WHERE k.deleted = 0
ORDER BY r.recurring_id, r.effective_from ASC;

insertRevision:
INSERT OR REPLACE INTO recurring_revision(
    id, recurring_id, effective_from, anchor_date, account_id, category_id, amount_minor, note, frequency,
    interval_count, weekday, month, day_of_month, auto_confirm
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteRevisions:
DELETE FROM recurring_revision WHERE recurring_id = ?;

insertLocalOccurrence:
INSERT OR IGNORE INTO recurring_occurrence_local(transaction_id, recurring_id, scheduled_date, revision_id)
VALUES (?, ?, ?, ?);

selectLocalOccurrences:
SELECT * FROM recurring_occurrence_local;

-- Máy này đã từng sinh kỳ này (kể cả khi dòng ledger/tombstone đã mất sau 410): không sinh lại.
hasLocalOccurrence:
SELECT count(*) FROM recurring_occurrence_local WHERE transaction_id = ?;

deleteLocalOccurrences:
DELETE FROM recurring_occurrence_local WHERE recurring_id = ?;

-- Pull lại từ đầu sau 410 sync.cursor_expired (ADR-008 T4). Xem Account.sq `deleteSynced`. Timeline đi theo khoản;
-- recurring_occurrence_local là dữ liệu chỉ trên máy nên giữ (kỳ đã sinh vẫn tránh sinh lại khi khoản về lại).
deleteSyncedRevisions:
DELETE FROM recurring_revision WHERE recurring_id NOT IN (SELECT entity_id FROM outbox WHERE entity = 'recurring');

deleteSynced:
DELETE FROM recurring WHERE id NOT IN (SELECT entity_id FROM outbox WHERE entity = 'recurring');
