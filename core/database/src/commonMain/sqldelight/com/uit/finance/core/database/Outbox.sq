-- Hàng chờ gửi lên server (ADR-002 §4). Mỗi dòng là một op của POST /sync/push.
-- `seq` giữ thứ tự gửi; sửa lại một bản ghi còn đang chờ thì cập nhật dòng cũ tại chỗ (giữ vị trí),
-- để op của ví vẫn đi trước op của giao dịch trỏ tới ví đó.
CREATE TABLE outbox (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    op_id TEXT NOT NULL UNIQUE,
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    action TEXT NOT NULL,
    payload TEXT,
    created_at INTEGER NOT NULL,
    attempts INTEGER NOT NULL DEFAULT 0,
    last_error TEXT
);

CREATE INDEX outbox_entity_idx ON outbox(entity, entity_id);

insert:
INSERT INTO outbox(op_id, entity, entity_id, action, payload, created_at)
VALUES (?, ?, ?, ?, ?, ?);

latestFor:
SELECT seq, action FROM outbox
WHERE entity = ? AND entity_id = ?
ORDER BY seq DESC
LIMIT 1;

replace:
UPDATE outbox
SET op_id = :opId, payload = :payload, created_at = :createdAt, attempts = 0, last_error = NULL
WHERE seq = :seq;

selectPending:
SELECT * FROM outbox
WHERE attempts < :maxAttempts
ORDER BY seq ASC
LIMIT :limit;

countAll:
SELECT COUNT(*) FROM outbox;

countParked:
SELECT COUNT(*) FROM outbox WHERE attempts >= ?;

hasPendingFor:
SELECT COUNT(*) FROM outbox WHERE entity = ? AND entity_id = ?;

markAttempt:
UPDATE outbox
SET attempts = attempts + 1, last_error = ?
WHERE op_id = ?;

deleteByOpId:
DELETE FROM outbox WHERE op_id = ?;
