<?xml version="1.0" encoding="utf-8"?>
<!--
    ADR-008 P4: không file nào của app rời máy qua sao lưu đám mây hay chuyển máy (Android 12+). allowBackup="false"
    chỉ tắt sao lưu đám mây; chuyển dữ liệu sang máy mới (device-transfer) phải tắt riêng ở đây. Sổ thu chi là
    SQLCipher với khoá trong Keystore (không đi theo sang máy khác), nên file sao lưu cũng vô dụng — nhưng không để
    nó rời máy là tốt hơn. Dữ liệu thật nằm trên server; máy mới đăng nhập là sync về.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
